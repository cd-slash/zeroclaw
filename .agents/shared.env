# =============================================================================
# MiniMax Provider Configuration
# =============================================================================
# MiniMax provides two separate providers:
#   - minimax: China domestic endpoint (api.minimaxi.com/v1)
#   - minimax-intl: International endpoint (api.minimax.io/v1)
#
# Choose the provider based on your account region:
# - China users: Use PROVIDER=minimax
# - International users: Use PROVIDER=minimax-intl
#
# Get your API key from https://platform.minimax.io/
# See available models at https://platform.minimax.io/docs/models

# For China users (api.minimaxi.com):
# PROVIDER=minimax
# MINIMAX_API_KEY=your-minimax-api-key-here
# ZEROCLAW_MODEL=minimax-text-01

# For International users (api.minimax.io):
# PROVIDER=minimax-intl
MINIMAX_API_KEY=sk-cp-gCp4Hhw-ZnMqmmZMfquP1qvjf5fSKn6Eobwz0ezN8Tz1erBZRSSTwQJI62Y1vS-G6vM93Rk6Mv3DKhsGJN_wmSz-3cHYUJDn4LaoM2WUwjMbHNzq5QKR-Og
# ZEROCLAW_MODEL=minimax-text-01

# =============================================================================
# Common LLM Provider Settings
# =============================================================================

# Default provider for all agents (can be overridden per-agent)
PROVIDER=minimax-intl

# Default model (agents can override with their own specialty models)
ZEROCLAW_MODEL=MiniMax-M2.5

# Default temperature
ZEROCLAW_TEMPERATURE=0.7

# =============================================================================
# Common Tunnel Settings
# =============================================================================

# Default tunnel provider (none, tailscale, cloudflare, ngrok)
TUNNEL_PROVIDER=none

# Tailscale auth key (shared - each agent gets its own machine name via hostname)
# TAILSCALE_AUTHKEY=tskey-auth-kV6CJ5e5sF11CNTRL-zDwxthkpdiCib75AjFJfiCnMeaQnNoKP

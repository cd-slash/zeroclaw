# =============================================================================
# MinIO Backup Configuration Example
# =============================================================================
# 
# Copy this file and rename it to .minio.env, then fill in your values.
# This enables automatic backup syncing to your MinIO server.
#
# Usage:
#   1. cp .agents/minio.env.example .agents/.minio.env
#   2. Edit .agents/.minio.env with your credentials
#   3. Source it: source .agents/.minio.env
#   4. Run backups: ./scripts/agent-backup.sh backup handy
#   5. Sync to MinIO: ./scripts/agent-backup.sh sync-to-minio handy

# =============================================================================
# MinIO Server Configuration
# =============================================================================

# MinIO server endpoint (use your Tailscale IP or hostname)
# Format: http(s)://hostname:port
MINIO_ENDPOINT=https://minio.your-tailnet.ts.net:9000

# MinIO credentials (create these in MinIO Console)
MINIO_ACCESS_KEY=your-access-key-here
MINIO_SECRET_KEY=your-secret-key-here

# Bucket name for ZeroClaw backups (will be created if doesn't exist)
MINIO_BUCKET=zeroclaw-backups

# =============================================================================
# Optional: Advanced Settings
# =============================================================================

# Enable SSL verification (set to 'false' for self-signed certs in dev)
# AWS_CA_BUNDLE=/path/to/ca-bundle.crt

# Custom region (usually not needed for MinIO)
# AWS_DEFAULT_REGION=us-east-1

# =============================================================================
# Testing Your Configuration
# =============================================================================
# 
# After setting these variables, test with:
#
#   # Install MinIO client if not already installed
#   brew install minio/stable/mc  # macOS
#   
#   # Configure alias
#   mc alias set myminio $MINIO_ENDPOINT $MINIO_ACCESS_KEY $MINIO_SECRET_KEY
#   
#   # Test connection
#   mc ls myminio
#   
#   # Create bucket if needed
#   mc mb myminio/$MINIO_BUCKET
#   
#   # Test upload
#   echo "test" > /tmp/test.txt
#   mc cp /tmp/test.txt myminio/$MINIO_BUCKET/
#   mc ls myminio/$MINIO_BUCKET/
#
# =============================================================================

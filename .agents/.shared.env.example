# =============================================================================
# Shared Configuration for All Agents
# =============================================================================
# Copy this file to .agents/.shared.env and fill in real secrets.
# Agent-specific .env files should only contain overrides.
# For per-agent env, use `.agents/<agent>/.env` (not committed).

# =============================================================================
# LLM Provider Credentials
# =============================================================================
# Use either API_KEY or provider-specific keys as needed by your provider setup.
API_KEY=replace-with-api-key

# MiniMax (international endpoint)
PROVIDER=minimax-intl
MINIMAX_API_KEY=replace-with-minimax-api-key

# =============================================================================
# Common Model Defaults
# =============================================================================
ZEROCLAW_MODEL=MiniMax-M2.5
ZEROCLAW_TEMPERATURE=0.7

# =============================================================================
# Common Tunnel Defaults
# =============================================================================
TUNNEL_PROVIDER=none

# =============================================================================
# Optional Shared Backup Settings (Litestream/MinIO)
# =============================================================================
# MINIO_ENDPOINT=https://minio.your-tailnet.ts.net:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=replace-with-strong-secret
# MINIO_BUCKET=zeroclaw-backups
# ZEROCLAW_SQLITE_WAL_MODE=true

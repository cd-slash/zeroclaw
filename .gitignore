/target
firmware/*/target
*.db
*.db-journal
.DS_Store
.wt-pr37/
__pycache__/
*.pyc
docker-compose.override.yml

# Environment files (may contain secrets)
.env
.env.*

# Python virtual environments

.venv/
venv/

# ESP32 build cache (esp-idf-sys managed)

.embuild/
.env.local
.env.*.local

# Secret keys and credentials
.secret_key
*.key
*.pem
credentials.json

# Multi-agent configuration - ignore hidden env files (contain secrets)
# but allow agent identity directories to be committed
.agents/.*.env
# Multi-agent configuration - ignore all .env files in agent directories
.agents/*/.env
.agents/.shared.env
.agents/*/.build-tools/*
!.agents/*/.build-tools/
!.agents/*/.build-tools/.gitkeep

# Ignore skills/tools directories (user-created content)
.agents/*/skills/*
!.agents/*/skills/.gitkeep
.agents/*/tools/*
!.agents/*/tools/.gitkeep

# Templates directory is tracked
!.agents/templates/

# MinIO credentials
.agents/minio.env
.minio.env

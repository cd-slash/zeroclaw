# ZeroClaw Environment Configuration

# Required: LLM Provider API Key
API_KEY=your-api-key-here

# Optional: Tailscale Authentication (for secure remote access)
# Get auth key from: https://login.tailscale.com/admin/settings/keys
TAILSCALE_AUTHKEY=
TAILSCALE_HOSTNAME=zeroclaw

# Optional: LLM Provider Settings
PROVIDER=openrouter
ZEROCLAW_MODEL=anthropic/claude-sonnet-4-20250514
ZEROCLAW_TEMPERATURE=0.7

# Optional: Gateway Port
ZEROCLAW_GATEWAY_PORT=3000
